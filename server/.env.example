# Server Configuration
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin
# cp .env.example .env

# Database
# PostgreSQL veritabanı bağlantı URL'i
DATABASE_URL="postgresql://postgres:password@localhost:5432/randevu_db"

# Server
PORT=3001
HOST=0.0.0.0

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Geocoding API (Opsiyonel)
GEOCODER_API_KEY=""

# File Upload
UPLOAD_DIR="./uploads"
